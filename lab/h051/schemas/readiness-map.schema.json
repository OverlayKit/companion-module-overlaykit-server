{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlaykit-h051-specification-readiness-map/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hypothesis",
    "status",
    "normative",
    "sourceLock",
    "mappingPolicy",
    "mappings",
    "predicateReceipts",
    "coverage",
    "carrierAssessment",
    "outcome",
    "claimBoundary",
    "adrAssessment",
    "authority",
    "action"
  ],
  "properties": {
    "schemaVersion": {
      "const": "overlaykit-h051-specification-readiness-map/v1"
    },
    "hypothesis": {
      "const": "H-051"
    },
    "status": {
      "const": "agent-proposed-pending-human-acceptance"
    },
    "normative": {
      "const": false
    },
    "sourceLock": {
      "const": {
        "path": "lab/h051/subject-lock.json",
        "rawSha256": "e95b3c806c512fd116e169be3bd02c8673e8fc39c72f28b245e8ab28fabe0a0a"
      }
    },
    "mappingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceForm",
        "targetForm",
        "specificationFixturePermitted",
        "proseCarrierCountsAsResolved",
        "machineReadableRelationshipRequiredByAgent",
        "humanAdjudicationRequired",
        "exhaustivenessBoundary",
        "abstractSlotUniverse"
      ],
      "properties": {
        "sourceForm": {
          "const": "exact-source-json-pointers-only"
        },
        "targetForm": {
          "const": "abstract-product-specification-slots-only"
        },
        "specificationFixturePermitted": {
          "const": false
        },
        "proseCarrierCountsAsResolved": {
          "const": false
        },
        "machineReadableRelationshipRequiredByAgent": {
          "const": false
        },
        "humanAdjudicationRequired": {
          "const": true
        },
        "exhaustivenessBoundary": {
          "const": "coverage is exact only over this finite abstract-slot universe; arbitrary prose semantics cannot be exhaustively refuted without human judgment"
        },
        "abstractSlotUniverse": {
          "type": "array",
          "minItems": 41,
          "maxItems": 41,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/abstractSlot"
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "$ref": "#/$defs/mappedAutomaticRecovery"
        },
        {
          "$ref": "#/$defs/mappedLinuxScope"
        },
        {
          "$ref": "#/$defs/mappedTrigger"
        },
        {
          "$ref": "#/$defs/mappedDelivery"
        },
        {
          "$ref": "#/$defs/mappedDeadline"
        },
        {
          "$ref": "#/$defs/mappedDegraded"
        },
        {
          "$ref": "#/$defs/mappedSafety"
        },
        {
          "$ref": "#/$defs/mappedAcceptance"
        },
        {
          "$ref": "#/$defs/ambiguousRelationship"
        }
      ],
      "items": false
    },
    "predicateReceipts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {
          "$ref": "#/$defs/receiptMappedAutomaticRecovery"
        },
        {
          "$ref": "#/$defs/receiptMappedLinuxScope"
        },
        {
          "$ref": "#/$defs/receiptMappedTrigger"
        },
        {
          "$ref": "#/$defs/receiptMappedDelivery"
