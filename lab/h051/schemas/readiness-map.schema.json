    "coverage": {
      "const": {
        "expectedMappingCount": 9,
        "mappedCount": 8,
        "ambiguousCount": 1,
        "omittedCount": 0,
        "expectedPredicateCount": 11,
        "satisfiedPredicateCount": 9,
        "ambiguousPredicateCount": 1,
        "unresolvedPredicateCount": 1,
        "conflicts": [],
        "unresolved": ["mapsSpecificationRelationship", "schemaCompilerAdmitsAdditiveLifecycle"]
      }
    },
    "carrierAssessment": {
      "const": {
        "predicate": "schemaCompilerCarrier",
        "status": "pending",
        "schemaSlotsEnumerated": true,
        "compilerSourcesClosed": true,
        "specificationFixturePresent": false,
        "reasonCode": "spec-shaped-fixture-not-authorized"
      }
    },
    "outcome": {
      "const": {
        "status": "inconclusive",
        "stage": "pre-review-specification-readiness",
        "reasonCode": "relationship-carrier-ambiguous-and-schema-compiler-pending",
        "humanAcceptanceRequired": true
      }
    },
    "claimBoundary": {
      "const": {
        "conclusion": "the map classifies only whether exact H-050 decision text has a source-cited abstract specification slot and exposes the unresolved relationship-carrier choice",
        "nonAuthority": "the map is agent-proposed evidence and is neither a specification nor authority to draft, accept, activate, or implement one",
        "excluded": "field prose, requirement identifiers, actors, terms, user stories, workflows, a SPEC-shaped fixture, mechanism selection, ADR creation, profile mutation, and product behavior"
      }
    },
    "adrAssessment": {
      "const": {
        "candidateActivated": false,
        "reason": "H-051 examines representation readiness and selects no durable architecture or mechanism."
      }
    },
    "authority": {
      "const": "none"
    },
    "action": {
      "type": "null"
    }
