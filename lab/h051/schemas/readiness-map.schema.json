  "$defs": {
    "abstractSlot": {
      "enum": [
        "acceptance.authoritative-effect",
        "acceptance.forbidden-effects",
        "acceptance.identity-receipts",
        "acceptance.monotonic-timing",
        "acceptance.physical-actuation-receipt",
        "acceptance.scenarios",
        "authority.prohibited-top-level-mutation",
        "authority.server-remains-authoritative",
        "degraded.intervention-limit",
        "degraded.manual-diagnosis",
        "degraded.operator-reset",
        "degraded.terminal-condition",
        "degraded.visibility-deadline",
        "identity.rejected-substitutes",
        "identity.serial-continuity",
        "obligation.failure-semantics",
        "obligation.mode",
        "obligation.operator-independence",
        "relationship.activation",
        "relationship.extends-existing-scope",
        "relationship.preserves-accepted-predecessors",
        "relationship.references-virtual-segment",
        "safety.no-duplicate-command",
        "safety.single-flight",
        "safety.target-revalidation",
        "scope.excluded-devices",
        "scope.nominated-device",
        "scope.runtime-role",
        "security.identity-and-credentials",
        "success.authoritative-state-effect",
        "success.authorized-command",
        "success.configuration-continuity",
        "success.physical-actuation",
        "success.rejected-proxies",
        "timing.actuation-window",
        "timing.clock",
        "timing.maximum",
        "timing.start-event",
        "timing.stop-event",
        "trigger.absence",
        "trigger.return-or-reenumeration"
      ]
    },
    "sourceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pointer"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\).+\\.json$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceCitations",
        "abstractSlots",
        "classification",
        "ambiguity",
        "rationale"
