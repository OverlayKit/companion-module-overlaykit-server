{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlaykit.dev/schemas/h040-docker-mapping-run/v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "hypothesis",
    "runId",
    "startedAt",
    "completedAt",
    "outcome",
    "collector",
    "inputs",
    "host",
    "device",
    "probe",
    "windows",
    "observations",
    "predicates",
    "invocationAudit",
    "claimBoundary",
    "cleanup",
    "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "overlaykit-h040-docker-mapping-run/v1" },
    "hypothesis": { "const": "H-040" },
    "runId": { "type": "string", "pattern": "^h040-" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "stage", "reason"],
          "properties": {
            "status": { "const": "supported" },
            "stage": { "const": "complete" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "stage", "reason"],
          "properties": {
            "status": { "const": "refuted" },
            "stage": { "const": "mapping-observation" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "collector": {
      "type": "object",
      "required": ["node", "commit", "sourceSha256", "sourceStable", "governance"],
      "properties": {
        "node": { "type": "string", "pattern": "^v22\\.(?:2[0-9]|[3-9][0-9])\\.[0-9]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceSha256": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "sourceStable": { "const": true },
        "governance": {
          "type": "object",
          "required": [
            "manifestSnapshotPath",
            "manifestFileSha256",
            "manifestContentHash",
            "changeSha256",
            "verifyReceiptPath",
            "verifyReceiptSha256",
            "planHash"
          ],
          "properties": {
            "manifestSnapshotPath": { "const": "governance-manifest.json" },
            "manifestFileSha256": { "$ref": "#/$defs/sha256" },
            "manifestContentHash": { "$ref": "#/$defs/sha256" },
            "changeSha256": { "$ref": "#/$defs/sha256" },
            "verifyReceiptPath": { "const": "governance-verify.txt" },
            "verifyReceiptSha256": { "$ref": "#/$defs/sha256" },
            "planHash": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["h039Path", "h039FileSha256", "h039EvidenceSha256", "h039VerifyReceipt"],
      "properties": {
        "h039Path": { "type": "string", "minLength": 1 },
        "h039FileSha256": { "$ref": "#/$defs/sha256" },
        "h039EvidenceSha256": { "$ref": "#/$defs/sha256" },
        "h039VerifyReceipt": { "$ref": "#/$defs/artifactReceipt" }
      },
      "additionalProperties": false
    },
    "host": { "$ref": "#/$defs/hostIdentity" },
    "device": {
      "type": "object",
      "required": [
        "vendorId",
        "productId",
        "model",
        "serial",
        "major",
        "minor",
        "initialPath",
        "returnedPath",
        "transition"
      ],
      "properties": {
        "vendorId": { "const": "0fd9" },
        "productId": { "const": "0080" },
        "model": { "type": "string", "minLength": 1 },
        "serial": { "type": "string", "minLength": 1 },
        "major": { "const": 241 },
        "minor": { "type": "integer", "minimum": 0 },
        "initialPath": { "type": "string", "pattern": "^/dev/hidraw[0-9]+$" },
        "returnedPath": { "type": "string", "pattern": "^/dev/hidraw[0-9]+$" },
        "transition": {
          "enum": [
            "same-path-same-rdev",
            "same-path-changed-rdev",
            "changed-path-same-rdev",
            "changed-path-changed-rdev"
          ]
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": [
        "name",
        "containerId",
        "imageReference",
        "imageId",
        "repoDigests",
        "privileged",
        "staticPath",
        "dynamicRoot",
        "lifecycleBefore",
        "lifecycleAfter",
        "lifecycleUnchanged",
        "security"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^h040-probe-" },
        "containerId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "imageReference": { "const": "node:22" },
        "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "repoDigests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "privileged": { "const": false },
        "staticPath": { "const": "/tmp/h040-static-hidraw" },
        "dynamicRoot": { "const": "/host-dev" },
        "lifecycleBefore": { "$ref": "#/$defs/probeLifecycle" },
        "lifecycleAfter": { "$ref": "#/$defs/probeLifecycle" },
        "lifecycleUnchanged": { "const": true },
        "security": {
          "type": "object",
          "required": [
            "network",
            "readOnlyRootfs",
            "capDrop",
            "noNewPrivileges",
            "user",
            "staticCgroupPermissions",
            "dynamicReadOnly"
          ],
          "properties": {
            "network": { "const": "none" },
            "readOnlyRootfs": { "const": true },
            "capDrop": {
              "type": "array",
              "prefixItems": [{ "const": "ALL" }],
              "minItems": 1,
              "maxItems": 1
            },
            "noNewPrivileges": { "const": true },
            "user": { "const": "65534:65534" },
            "staticCgroupPermissions": { "const": "m" },
            "dynamicReadOnly": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "windows": {
      "type": "object",
      "required": ["disconnect", "reconnect"],
      "properties": {
        "disconnect": { "$ref": "#/$defs/window" },
        "reconnect": { "$ref": "#/$defs/window" }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": ["initial", "absent", "returned", "hostPollArtifact"],
      "properties": {
        "initial": {
          "allOf": [
            { "$ref": "#/$defs/stageObservation" },
            {
              "properties": {
                "host": { "$ref": "#/$defs/presentHostSnapshot" }
              }
            }
          ]
        },
        "absent": {
          "allOf": [
            { "$ref": "#/$defs/stageObservation" },
            {
              "properties": {
                "host": { "$ref": "#/$defs/absentHostSnapshot" }
              }
            }
          ]
        },
        "returned": {
          "allOf": [
            { "$ref": "#/$defs/stageObservation" },
            {
              "properties": {
                "host": { "$ref": "#/$defs/presentHostSnapshot" }
              }
            }
          ]
        },
        "hostPollArtifact": { "$ref": "#/$defs/artifactReceipt" }
      },
      "additionalProperties": false
    },
    "predicates": {
      "type": "object",
      "required": [
        "complete",
        "metadataOnly",
        "dynamicInitialMatchesHost",
        "dynamicReturnedMatchesHost",
        "dynamicAbsent",
        "staticPersists",
        "staticUnchanged",
        "hostEpochChanged"
      ],
      "properties": {
        "complete": { "type": "boolean" },
        "metadataOnly": { "type": "boolean" },
        "dynamicInitialMatchesHost": { "type": "boolean" },
        "dynamicReturnedMatchesHost": { "type": "boolean" },
        "dynamicAbsent": { "type": "boolean" },
        "staticPersists": { "type": "boolean" },
        "staticUnchanged": { "type": "boolean" },
        "hostEpochChanged": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "invocationAudit": {
      "type": "object",
      "required": [
        "mode",
        "metadataOnly",
        "deviceReads",
        "deviceWrites",
        "virtualInvocationCount",
        "entries",
        "forbidden",
        "passed"
      ],
      "properties": {
        "mode": { "const": "metadata-only" },
        "metadataOnly": { "const": true },
        "deviceReads": { "const": 0 },
        "deviceWrites": { "const": 0 },
        "virtualInvocationCount": { "const": 0 },
        "entries": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/dockerRunAuditEntry" },
            { "$ref": "#/$defs/dockerInspectAuditEntry" },
            {
              "allOf": [
                { "$ref": "#/$defs/dockerStatAuditEntry" },
                {
                  "properties": {
                    "view": { "const": "initial-static" },
                    "path": { "const": "/tmp/h040-static-hidraw" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/dockerStatAuditEntry" },
                {
                  "properties": {
                    "view": { "const": "initial-dynamic" },
                    "path": { "type": "string", "pattern": "^/host-dev/hidraw[0-9]+$" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/dockerStatAuditEntry" },
                {
                  "properties": {
                    "view": { "const": "absent-static" },
                    "path": { "const": "/tmp/h040-static-hidraw" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/dockerStatAuditEntry" },
                {
                  "properties": {
                    "view": { "const": "absent-dynamic" },
                    "path": { "type": "string", "pattern": "^/host-dev/hidraw[0-9]+$" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/dockerStatAuditEntry" },
                {
                  "properties": {
                    "view": { "const": "returned-static" },
                    "path": { "const": "/tmp/h040-static-hidraw" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/dockerStatAuditEntry" },
                {
                  "properties": {
                    "view": { "const": "returned-dynamic" },
                    "path": { "type": "string", "pattern": "^/host-dev/hidraw[0-9]+$" }
                  }
                }
              ]
            },
            { "$ref": "#/$defs/dockerInspectAuditEntry" },
            { "$ref": "#/$defs/dockerStopAuditEntry" }
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "forbidden": { "type": "array", "maxItems": 0 },
        "passed": { "const": true }
      },
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": ["proves", "excludes"],
      "properties": {
        "proves": { "$ref": "#/$defs/nonEmptyStrings" },
        "excludes": { "$ref": "#/$defs/nonEmptyStrings" }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "startedAt",
        "completedAt",
        "containerId",
        "containerRemoved",
        "host",
        "owners",
        "hostConfigurationChanged",
        "successful",
        "error"
      ],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "containerId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "containerRemoved": { "const": true },
        "host": { "$ref": "#/$defs/presentHostSnapshot" },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["devicePath", "owner"],
            "properties": {
              "devicePath": { "type": "string", "pattern": "^/dev/hidraw[0-9]+$" },
              "owner": { "type": "object", "minProperties": 1 }
            },
            "additionalProperties": false
          }
        },
        "hostConfigurationChanged": { "const": false },
        "successful": { "const": true },
        "error": { "type": "null" }
      },
      "additionalProperties": false
    },
    "evidenceSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "supported" } },
            "required": ["status"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "predicates": {
            "properties": {
              "complete": { "const": true },
              "metadataOnly": { "const": true },
              "dynamicInitialMatchesHost": { "const": true },
              "dynamicReturnedMatchesHost": { "const": true },
              "dynamicAbsent": { "const": true },
              "staticPersists": { "const": true },
              "staticUnchanged": { "const": true },
              "hostEpochChanged": { "const": true }
            }
          },
          "observations": {
            "properties": {
              "initial": {
                "properties": {
                  "static": { "$ref": "#/$defs/staticValueProbeStat" },
                  "dynamic": { "$ref": "#/$defs/dynamicValueProbeStat" }
                }
              },
              "absent": {
                "properties": {
                  "static": { "$ref": "#/$defs/staticValueProbeStat" },
                  "dynamic": { "$ref": "#/$defs/dynamicMissingProbeStat" }
                }
              },
              "returned": {
                "properties": {
                  "static": { "$ref": "#/$defs/staticValueProbeStat" },
                  "dynamic": { "$ref": "#/$defs/dynamicValueProbeStat" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "refuted" } },
            "required": ["status"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "predicates": {
            "allOf": [
              {
                "properties": {
                  "complete": { "const": true },
                  "metadataOnly": { "const": true }
                }
              },
              {
                "not": {
                  "properties": {
                    "dynamicInitialMatchesHost": { "const": true },
                    "dynamicReturnedMatchesHost": { "const": true },
                    "dynamicAbsent": { "const": true },
                    "staticPersists": { "const": true },
                    "staticUnchanged": { "const": true },
                    "hostEpochChanged": { "const": true }
                  },
                  "required": [
                    "dynamicInitialMatchesHost",
                    "dynamicReturnedMatchesHost",
                    "dynamicAbsent",
                    "staticPersists",
                    "staticUnchanged",
                    "hostEpochChanged"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "monotonicNs": { "type": "string", "pattern": "^[0-9]+$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifactReceipt": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "dockerRunAuditEntry": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "imageReference",
        "staticHostPath",
        "staticContainerPath",
        "staticCgroupPermissions",
        "dynamicHostPath",
        "dynamicContainerPath",
        "dynamicReadOnly",
        "user",
        "network",
        "readOnlyRootfs",
        "capDrop",
        "noNewPrivileges",
        "command",
        "metadataOnly"
      ],
      "properties": {
        "kind": { "const": "docker-run" },
        "name": { "type": "string", "pattern": "^h040-probe-" },
        "imageReference": { "const": "node:22" },
        "staticHostPath": { "type": "string", "pattern": "^/dev/hidraw[0-9]+$" },
        "staticContainerPath": { "const": "/tmp/h040-static-hidraw" },
        "staticCgroupPermissions": { "const": "m" },
        "dynamicHostPath": { "const": "/dev" },
        "dynamicContainerPath": { "const": "/host-dev" },
        "dynamicReadOnly": { "const": true },
        "user": { "const": "65534:65534" },
        "network": { "const": "none" },
        "readOnlyRootfs": { "const": true },
        "capDrop": {
          "type": "array",
          "prefixItems": [{ "const": "ALL" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "noNewPrivileges": { "const": true },
        "command": {
          "type": "array",
          "prefixItems": [{ "const": "sleep" }, { "const": "infinity" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "metadataOnly": { "const": true }
      },
      "additionalProperties": false
    },
    "dockerInspectAuditEntry": {
      "type": "object",
      "required": ["kind", "target", "metadataOnly"],
      "properties": {
        "kind": { "const": "docker-inspect" },
        "target": { "type": "string", "pattern": "^h040-probe-" },
        "metadataOnly": { "const": true }
      },
      "additionalProperties": false
    },
    "dockerStatAuditEntry": {
      "type": "object",
      "required": ["kind", "view", "path", "operation", "metadataOnly"],
      "properties": {
        "kind": { "const": "docker-stat" },
        "view": {
          "enum": [
            "initial-static",
            "initial-dynamic",
            "absent-static",
            "absent-dynamic",
            "returned-static",
            "returned-dynamic"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/tmp/h040-static-hidraw|/host-dev/hidraw[0-9]+)$"
        },
        "operation": { "const": "fs.statSync" },
        "metadataOnly": { "const": true }
      },
      "additionalProperties": false
    },
    "dockerStopAuditEntry": {
      "type": "object",
      "required": ["kind", "target", "timeoutSeconds", "metadataOnly"],
      "properties": {
        "kind": { "const": "docker-stop" },
        "target": { "type": "string", "pattern": "^h040-probe-" },
        "timeoutSeconds": { "const": 5 },
        "metadataOnly": { "const": true }
      },
      "additionalProperties": false
    },
    "probeLifecycle": {
      "type": "object",
      "required": [
        "containerId",
        "name",
        "imageId",
        "running",
        "startedAt",
        "restartCount",
        "hostPid",
        "pid1StartTicks",
        "restartPolicy",
        "autoRemove",
        "networkMode",
        "privileged",
        "readOnlyRootfs",
        "capDrop",
        "securityOpt",
        "groupAdd",
        "pidsLimit",
        "memory",
        "deviceCgroupRules",
        "user",
        "command",
        "devices",
        "mounts"
      ],
      "properties": {
        "containerId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "name": { "type": "string", "pattern": "^h040-probe-" },
        "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "running": { "const": true },
        "startedAt": { "type": "string", "format": "date-time" },
        "restartCount": { "const": 0 },
        "hostPid": { "type": "integer", "minimum": 1 },
        "pid1StartTicks": { "type": "integer", "minimum": 1 },
        "restartPolicy": { "const": "no" },
        "autoRemove": { "const": true },
        "networkMode": { "const": "none" },
        "privileged": { "const": false },
        "readOnlyRootfs": { "const": true },
        "capDrop": {
          "type": "array",
          "prefixItems": [{ "const": "ALL" }],
          "minItems": 1,
          "maxItems": 1
        },
        "securityOpt": {
          "type": "array",
          "prefixItems": [{ "const": "no-new-privileges" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "groupAdd": { "type": "array", "maxItems": 0 },
        "pidsLimit": { "const": 32 },
        "memory": { "const": 134217728 },
        "deviceCgroupRules": { "type": "null" },
        "user": { "const": "65534:65534" },
        "command": {
          "type": "array",
          "prefixItems": [{ "const": "sleep" }, { "const": "infinity" }],
          "minItems": 2,
          "maxItems": 2
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["pathOnHost", "pathInContainer", "cgroupPermissions"],
            "properties": {
              "pathOnHost": { "type": "string", "pattern": "^/dev/hidraw[0-9]+$" },
              "pathInContainer": { "const": "/tmp/h040-static-hidraw" },
              "cgroupPermissions": { "const": "m" }
            },
            "additionalProperties": false
          }
        },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["type", "source", "destination", "rw"],
            "properties": {
              "type": { "const": "bind" },
              "source": { "const": "/dev" },
              "destination": { "const": "/host-dev" },
              "rw": { "const": false }
            },
            "additionalProperties": false
          },
          "minContains": 1,
          "maxContains": 1,
          "items": {
            "type": "object",
            "required": ["type", "source", "destination", "rw"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "destination": { "type": "string", "minLength": 1 },
              "rw": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hostIdentity": {
      "type": "object",
      "required": [
        "observedAt",
        "osId",
        "osVersion",
        "kernel",
        "architecture",
        "machine",
        "principal",
        "graphicalSession"
      ],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "osId": { "const": "fedora" },
        "osVersion": { "const": "43" },
        "kernel": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x64" },
        "machine": { "const": "x86_64" },
        "principal": { "type": "object", "minProperties": 1 },
        "graphicalSession": { "type": "object", "minProperties": 1 }
      },
      "additionalProperties": false
    },
    "hostSnapshot": {
      "type": "object",
      "required": [
        "capturedAt",
        "monotonicNs",
        "expectedSerial",
        "scope",
        "lsusb",
        "usb",
        "hidraw",
        "priorPath",
        "errors",
        "state"
      ],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "monotonicNs": { "$ref": "#/$defs/monotonicNs" },
        "expectedSerial": { "type": "string", "minLength": 1 },
        "scope": { "type": "object", "minProperties": 1 },
        "lsusb": {
          "type": "object",
          "required": ["observed", "exitCode", "errorCode", "matches", "stderr"],
          "properties": {
            "observed": { "const": true },
            "exitCode": { "const": 0 },
            "errorCode": { "type": "null" },
            "matches": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "stderr": { "type": "string" }
          },
          "additionalProperties": false
        },
        "usb": { "type": "array" },
        "hidraw": { "type": "array" },
        "priorPath": { "type": "object" },
        "errors": { "type": "array", "maxItems": 0 },
        "state": { "enum": ["present", "absent"] }
      },
      "additionalProperties": false
    },
    "presentHostSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/hostSnapshot" },
        {
          "properties": {
            "state": { "const": "present" },
            "lsusb": {
              "properties": {
                "matches": { "type": "array", "minItems": 1 }
              }
            },
            "usb": { "type": "array", "minItems": 1 },
            "hidraw": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "absentHostSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/hostSnapshot" },
        {
          "properties": {
            "state": { "const": "absent" },
            "lsusb": {
              "properties": {
                "matches": { "type": "array", "maxItems": 0 }
              }
            },
            "usb": { "type": "array", "maxItems": 0 },
            "hidraw": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "deviceStat": {
      "type": "object",
      "required": [
        "stDev",
        "inode",
        "ctimeNs",
        "rdev",
        "rdevHex",
        "major",
        "minor",
        "isCharacterDevice"
      ],
      "properties": {
        "stDev": { "type": "string", "pattern": "^[0-9]+$" },
        "inode": { "type": "string", "pattern": "^[0-9]+$" },
        "ctimeNs": { "type": "string", "pattern": "^[0-9]+$" },
        "rdev": { "type": "string", "pattern": "^[0-9]+$" },
        "rdevHex": { "type": "string", "pattern": "^[0-9a-f]+:[0-9a-f]+$" },
        "major": { "const": 241 },
        "minor": { "type": "integer", "minimum": 0 },
        "isCharacterDevice": { "const": true }
      },
      "additionalProperties": false
    },
    "staticValueProbeStat": {
      "type": "object",
      "required": ["kind", "path", "value"],
      "properties": {
        "kind": { "const": "value" },
        "path": { "const": "/tmp/h040-static-hidraw" },
        "value": { "$ref": "#/$defs/deviceStat" }
      },
      "additionalProperties": false
    },
    "staticMissingProbeStat": {
      "type": "object",
      "required": ["kind", "path", "code"],
      "properties": {
        "kind": { "const": "missing" },
        "path": { "const": "/tmp/h040-static-hidraw" },
        "code": { "const": "ENOENT" }
      },
      "additionalProperties": false
    },
    "dynamicValueProbeStat": {
      "type": "object",
      "required": ["kind", "path", "value"],
      "properties": {
        "kind": { "const": "value" },
        "path": { "type": "string", "pattern": "^/host-dev/hidraw[0-9]+$" },
        "value": { "$ref": "#/$defs/deviceStat" }
      },
      "additionalProperties": false
    },
    "dynamicMissingProbeStat": {
      "type": "object",
      "required": ["kind", "path", "code"],
      "properties": {
        "kind": { "const": "missing" },
        "path": { "type": "string", "pattern": "^/host-dev/hidraw[0-9]+$" },
        "code": { "const": "ENOENT" }
      },
      "additionalProperties": false
    },
    "stageObservation": {
      "type": "object",
      "required": ["capturedAt", "monotonicNs", "host", "static", "dynamic"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "monotonicNs": { "$ref": "#/$defs/monotonicNs" },
        "host": { "$ref": "#/$defs/hostSnapshot" },
        "static": {
          "oneOf": [
            { "$ref": "#/$defs/staticValueProbeStat" },
            { "$ref": "#/$defs/staticMissingProbeStat" }
          ]
        },
        "dynamic": {
          "oneOf": [
            { "$ref": "#/$defs/dynamicValueProbeStat" },
            { "$ref": "#/$defs/dynamicMissingProbeStat" }
          ]
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": [
        "stage",
        "challenge",
        "openedAt",
        "openedMonotonicNs",
        "timeoutSeconds",
        "instruction",
        "closedAt",
        "closedMonotonicNs"
      ],
      "properties": {
        "stage": { "enum": ["disconnect", "reconnect"] },
        "challenge": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "openedAt": { "type": "string", "format": "date-time" },
        "openedMonotonicNs": { "$ref": "#/$defs/monotonicNs" },
        "timeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 300 },
        "instruction": { "type": "string", "minLength": 1 },
        "closedAt": { "type": "string", "format": "date-time" },
        "closedMonotonicNs": { "$ref": "#/$defs/monotonicNs" }
      },
      "additionalProperties": false
    }
  }
}
