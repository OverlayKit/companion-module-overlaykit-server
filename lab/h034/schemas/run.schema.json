{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlaykit.dev/schemas/h034-run.schema.json",
  "title": "OverlayKit H-034 run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "classification",
    "startedAt",
    "completedAt",
    "host",
    "inputs",
    "labDefinitionSha256",
    "moduleArchiveSha256",
    "nodes",
    "network",
    "provisioning",
    "receipts",
    "semanticAssertions",
    "excludedClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "overlaykit-h034-run/v1" },
    "runId": { "type": "string", "minLength": 8, "maxLength": 160 },
    "classification": { "enum": ["canonical", "supplemental"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "maintainerSpecific"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "maintainerSpecific": { "type": "boolean" }
      }
    },
    "inputs": { "type": "object" },
    "labDefinitionSha256": { "$ref": "#/$defs/sha256" },
    "moduleArchiveSha256": { "$ref": "#/$defs/sha256" },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "address", "os", "osVersion", "nodeVersion"],
        "properties": {
          "id": { "enum": ["overlaykit", "companion"] },
          "address": { "enum": ["172.31.34.10", "172.31.34.20"] },
          "os": { "const": "ubuntu" },
          "osVersion": { "const": "24.04" },
          "nodeVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "loopback", "tailscale", "cloud", "socketObserved"],
      "properties": {
        "endpoint": { "const": "ws://172.31.34.10:8081/device" },
        "loopback": { "const": false },
        "tailscale": { "const": false },
        "cloud": { "const": false },
        "socketObserved": { "const": true }
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showId",
        "credentialId",
        "audienceCredentialId",
        "bearerSha256",
        "ephemeral",
        "secretPersisted"
      ],
      "properties": {
        "showId": { "type": "string", "minLength": 1 },
        "credentialId": { "type": "string", "minLength": 1 },
        "audienceCredentialId": { "type": "string", "minLength": 1 },
        "bearerSha256": { "$ref": "#/$defs/sha256" },
        "ephemeral": { "const": true },
        "secretPersisted": { "const": false }
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "pattern": "^receipts/[a-z0-9._-]+\\.json$" }
    },
    "semanticAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "twoUbuntuNodes",
        "nonLoopbackProductTraffic",
        "actualCompanion",
        "actualOverlayKit",
        "exactModuleArchive",
        "showHideToggle",
        "sixVisibleStates",
        "causalReceipts",
        "threeSecondRule",
        "noPrivateDependencies"
      ],
      "properties": {
        "twoUbuntuNodes": { "const": true },
        "nonLoopbackProductTraffic": { "const": true },
        "actualCompanion": { "const": true },
        "actualOverlayKit": { "const": true },
        "exactModuleArchive": { "const": true },
        "showHideToggle": { "const": true },
        "sixVisibleStates": { "const": true },
        "causalReceipts": { "const": true },
        "threeSecondRule": { "const": true },
        "noPrivateDependencies": { "const": true }
      }
    },
    "excludedClaims": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
