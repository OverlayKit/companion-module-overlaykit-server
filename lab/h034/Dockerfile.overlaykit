FROM node:24.6.0-bookworm@sha256:d2b6b5aedb5b729f68ee1129e0f5a5d4713d93f82448249e82241876d8e8d86e AS builder
ARG OVERLAYKIT_COMMIT
ARG OVERLAYKIT_ARCHIVE_SHA256
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN printf '%s' "${OVERLAYKIT_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
  && printf '%s' "${OVERLAYKIT_ARCHIVE_SHA256}" | grep -Eq '^[0-9a-f]{64}$' \
  && curl --fail --location --silent --show-error \
    "https://codeload.github.com/OverlayKit/overlaykit/tar.gz/${OVERLAYKIT_COMMIT}" \
    --output /tmp/overlaykit.tar.gz \
  && printf '%s  %s\n' "${OVERLAYKIT_ARCHIVE_SHA256}" /tmp/overlaykit.tar.gz | sha256sum --check \
  && tar -xzf /tmp/overlaykit.tar.gz --strip-components=1 -C /src \
  && rm /tmp/overlaykit.tar.gz
RUN npm ci --engine-strict --no-audit --no-fund --maxsockets=1 \
  && npm run server:build

FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90
ARG DEBIAN_FRONTEND=noninteractive
ARG OVERLAYKIT_COMMIT
RUN printf '%s' "${OVERLAYKIT_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --shell /bin/bash overlaykit
COPY --from=builder /usr/local /usr/local
COPY --from=builder /src /opt/overlaykit
COPY lab/h034/device-proxy.cjs /opt/h034/device-proxy.cjs
COPY lab/h034/lib/proxy-evidence.cjs /opt/h034/lib/proxy-evidence.cjs
COPY lab/h034/overlaykit-entrypoint.sh /usr/local/bin/h034-overlaykit
RUN mkdir -p /data /evidence \
  && chmod 0555 /usr/local/bin/h034-overlaykit \
  && chown -R overlaykit:overlaykit /data /evidence

ENV H034_OVERLAYKIT_COMMIT="${OVERLAYKIT_COMMIT}"
ENV NODE_PATH=/opt/overlaykit/node_modules
EXPOSE 3000 8081 9090
USER root
ENTRYPOINT ["/usr/local/bin/h034-overlaykit"]
