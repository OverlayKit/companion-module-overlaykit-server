{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlaykit.dev/schemas/h035-host-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hypothesis",
    "collectedAt",
    "collector",
    "host",
    "usb",
    "hidraw",
    "companionProcesses",
    "claimBoundary",
    "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "overlaykit-h035-host-inventory/v1" },
    "hypothesis": { "const": "H-035" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "workingTreeClean",
        "node",
        "sourceSha256",
        "governanceManifestContentHash"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workingTreeClean": { "type": "boolean" },
        "node": { "type": "string", "pattern": "^v[0-9]+\\." },
        "sourceSha256": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "governanceManifestContentHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osRelease", "kernel", "architecture", "hostname", "principal"],
      "properties": {
        "osRelease": { "type": "object", "additionalProperties": { "type": "string" } },
        "kernel": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "uid", "primaryGroup", "gid", "groups"],
          "properties": {
            "user": { "type": "string", "minLength": 1 },
            "uid": { "type": "integer", "minimum": 0 },
            "primaryGroup": { "type": "string", "minLength": 1 },
            "gid": { "type": "integer", "minimum": 0 },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gid", "name"],
                "properties": {
                  "gid": { "type": "integer", "minimum": 0 },
                  "name": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "usb": { "$ref": "#/$defs/usbObservation" },
    "hidraw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "errorCode", "matches"],
      "properties": {
        "observed": { "type": "boolean" },
        "errorCode": { "type": ["string", "null"] },
        "matches": {
          "type": "array",
          "items": { "$ref": "#/$defs/hidrawObservation" }
        }
      }
    },
    "companionProcesses": { "$ref": "#/$defs/processObservation" },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proves", "excludes"],
      "properties": {
        "proves": { "$ref": "#/$defs/nonEmptyStrings" },
        "excludes": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "evidenceSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commandState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "exitCode", "errorCode"],
      "properties": {
        "observed": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"] },
        "errorCode": { "type": ["string", "null"] }
      }
    },
    "usbObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "observed", "exitCode", "errorCode", "matches", "stderr"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendorId", "productId", "label"],
          "properties": {
            "vendorId": { "const": "0fd9" },
            "productId": { "const": "0080" },
            "label": { "const": "Elgato Stream Deck MK.2" }
          }
        },
        "observed": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"] },
        "errorCode": { "type": ["string", "null"] },
        "matches": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stderr": { "type": "string" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "uid", "gid", "rdev", "ueventSha256"],
      "properties": {
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "rdev": { "type": "integer", "minimum": 0 },
        "ueventSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "accessResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "errorCode"],
      "properties": {
        "allowed": { "type": "boolean" },
        "errorCode": { "type": ["string", "null"] }
      }
    },
    "openResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opened", "errorCode"],
      "properties": {
        "opened": { "type": "boolean" },
        "errorCode": { "type": ["string", "null"] }
      }
    },
    "ownerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "usageError", "exitCode", "errorCode", "pids", "stdout", "stderr"],
      "properties": {
        "observed": { "type": "boolean" },
        "usageError": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"] },
        "errorCode": { "type": ["string", "null"] },
        "pids": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    },
    "processObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "exitCode", "errorCode", "matches"],
      "properties": {
        "observed": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"] },
        "errorCode": { "type": ["string", "null"] },
        "matches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hidrawObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "devicePath",
        "sysfsDevicePath",
        "hid",
        "udev",
        "before",
        "access",
        "opens",
        "owners",
        "after",
        "identityStable",
        "ioOperations"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^hidraw[0-9]+$" },
        "devicePath": { "type": "string", "pattern": "^/dev/hidraw[0-9]+$" },
        "sysfsDevicePath": { "type": "string", "minLength": 1 },
        "hid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "physicalPath", "unique"],
          "properties": {
            "id": { "type": "string", "pattern": "^0003:00000[Ff][Dd]9:00000080$" },
            "name": { "type": ["string", "null"] },
            "physicalPath": { "type": ["string", "null"] },
            "unique": { "type": ["string", "null"] }
          }
        },
        "udev": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "exitCode", "errorCode", "properties", "stderr"],
          "properties": {
            "observed": { "type": "boolean" },
            "exitCode": { "type": ["integer", "null"] },
            "errorCode": { "type": ["string", "null"] },
            "properties": { "type": "object", "additionalProperties": { "type": "string" } },
            "stderr": { "type": "string" }
          }
        },
        "before": { "$ref": "#/$defs/snapshot" },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "$ref": "#/$defs/accessResult" },
            "write": { "$ref": "#/$defs/accessResult" }
          }
        },
        "opens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readOnlyNonblocking", "readWriteNonblocking"],
          "properties": {
            "readOnlyNonblocking": { "$ref": "#/$defs/openResult" },
            "readWriteNonblocking": { "$ref": "#/$defs/openResult" }
          }
        },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after", "processes"],
          "properties": {
            "before": { "$ref": "#/$defs/ownerObservation" },
            "after": { "$ref": "#/$defs/ownerObservation" },
            "processes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pid", "observed", "detail"],
                "properties": {
                  "pid": { "type": "integer", "minimum": 1 },
                  "observed": { "type": "boolean" },
                  "detail": { "type": "string" }
                }
              }
            }
          }
        },
        "after": { "$ref": "#/$defs/snapshot" },
        "identityStable": { "type": "boolean" },
        "ioOperations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytesRead", "bytesWritten", "implementation"],
          "properties": {
            "bytesRead": { "const": 0 },
            "bytesWritten": { "const": 0 },
            "implementation": { "const": "open-and-close-only" }
          }
        }
      }
    }
  }
}
