{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlaykit-h043-offline-worker-eligibility-run/v1",
  "title": "OverlayKit H-043 offline worker eligibility evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "hypothesis",
    "runId",
    "startedAt",
    "completedAt",
    "outcome",
    "collector",
    "input",
    "prefix",
    "causalBoundary",
    "canonicalClassification",
    "hostileMatrix",
    "sideEffectAudit",
    "claimBoundary",
    "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "overlaykit-h043-offline-worker-eligibility-run/v1"
    },
    "hypothesis": {
      "const": "H-043"
    },
    "runId": {
      "type": "string",
      "pattern": "^h043-[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3])-[0-5][0-9]-[0-5][0-9](?:-[0-9]{1,9})?Z-[0-9a-f]{8}$"
    },
    "startedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "completedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "collector": {
      "$ref": "#/$defs/collector"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "prefix": {
      "$ref": "#/$defs/prefixManifest"
    },
    "causalBoundary": {
      "$ref": "#/$defs/causalBoundary"
    },
    "canonicalClassification": {
      "$ref": "#/$defs/classification"
    },
    "hostileMatrix": {
      "$ref": "#/$defs/hostileMatrix"
    },
    "sideEffectAudit": {
      "$ref": "#/$defs/sideEffectAudit"
    },
    "claimBoundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "evidenceSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "stage": {
                "const": "offline-worker-eligibility"
              },
              "reasonCode": {
                "const": "canonical-candidate-and-hostile-matrix-exact"
              }
            }
          },
          "collector": {
            "properties": {
              "sourceStable": {
                "const": true
              }
            }
          },
          "canonicalClassification": {
            "properties": {
              "disposition": {
                "const": "candidate"
              }
            }
          },
          "hostileMatrix": {
            "$ref": "#/$defs/exactPassingHostileMatrix"
          },
          "sideEffectAudit": {
            "$ref": "#/$defs/exactZeroSideEffectAudit"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "const": "refuted"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "outcome": {
                "properties": {
                  "stage": {
                    "const": "side-effect-boundary"
                  },
                  "reasonCode": {
                    "const": "side-effect-observed"
                  }
                }
              },
              "sideEffectAudit": {
                "$ref": "#/$defs/nonZeroSideEffectAudit"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "properties": {
                  "stage": {
                    "const": "hostile-matrix"
                  },
                  "reasonCode": {
                    "const": "hostile-case-or-tail-independence-failed"
                  }
                }
              },
              "hostileMatrix": {
                "allOf": [
                  {
                    "$ref": "#/$defs/hostileMatrix"
                  },
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "allPassed": {
                            "const": false
                          }
                        }
                      },
                      {
                        "properties": {
                          "tailIndependent": {
                            "const": false
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "sideEffectAudit": {
                "$ref": "#/$defs/exactZeroSideEffectAudit"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "properties": {
                  "stage": {
                    "const": "canonical-classification"
                  },
                  "reasonCode": {
                    "const": "canonical-prefix-not-eligible"
                  }
                }
              },
              "collector": {
                "properties": {
                  "sourceStable": {
                    "const": true
                  }
                }
              },
              "canonicalClassification": {
                "properties": {
                  "disposition": {
                    "const": "withheld"
                  }
                }
              },
              "hostileMatrix": {
                "$ref": "#/$defs/exactPassingHostileMatrix"
              },
              "sideEffectAudit": {
                "$ref": "#/$defs/exactZeroSideEffectAudit"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "const": "inconclusive"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "outcome": {
                "properties": {
                  "stage": {
                    "const": "source-admission"
                  },
                  "reasonCode": {
                    "const": "source-set-unstable"
                  }
                }
              },
              "collector": {
                "properties": {
                  "sourceStable": {
                    "const": false
                  }
                }
              },
              "hostileMatrix": {
                "$ref": "#/$defs/exactPassingHostileMatrix"
              },
              "sideEffectAudit": {
                "$ref": "#/$defs/exactZeroSideEffectAudit"
              }
            }
          },
          {
            "properties": {
              "outcome": {
                "properties": {
                  "stage": {
                    "const": "prefix-boundary"
                  },
                  "reasonCode": {
                    "const": "canonical-prefix-inconclusive"
                  }
                }
              },
              "collector": {
                "properties": {
                  "sourceStable": {
                    "const": true
                  }
                }
              },
              "canonicalClassification": {
                "properties": {
                  "disposition": {
                    "const": "inconclusive"
                  }
                }
              },
              "hostileMatrix": {
                "$ref": "#/$defs/exactPassingHostileMatrix"
              },
              "sideEffectAudit": {
                "$ref": "#/$defs/exactZeroSideEffectAudit"
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
