  "rules": [
    {
      "id": "accepted-records-are-immutable",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "Accepted decisions, accepted specifications, and implemented change contracts are never edited or deleted; a successor receives a new identifier."
    },
    {
      "id": "adapter-is-not-protocol-authority",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "The adapter consumes exact public @overlaykit/protocol artifacts and may not copy, weaken, or independently implement protocol admission."
    },
    {
      "id": "agents-are-delegated",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "An agent has no independent project authority and must name its registered human principal."
    },
    {
      "id": "attestation-execution-identity-remains-exact",
      "kind": "rule",
      "sourceDecision": "ADR-0004",
      "statement": "Subject selection cannot weaken exact signer workflow, source, OIDC, runner, event, and invocation verification."
    },
    {
      "id": "base-change-status-is-hash-bound",
      "kind": "rule",
      "sourceDecision": "ADR-0002",
      "statement": "Lifecycle status used for immutability must come from the exact base blob whose raw SHA-256 matches the base manifest."
    },
    {
      "id": "change-history-cannot-disappear",
      "kind": "rule",
      "sourceDecision": "ADR-0002",
      "statement": "Every change identity present in the base manifest must remain present in the current manifest regardless of lifecycle status."
    },
    {
      "id": "change-immutability-starts-from-implemented-base",
      "kind": "rule",
      "sourceDecision": "ADR-0002",
      "statement": "A change contract is byte-immutable when its schema-valid and manifest-hash-matched blob at the exact base ref declares status implemented."
    },
    {
      "id": "claims-are-typed",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "Every change separates facts, inferences, assumptions, and unknowns; facts and inferences require evidence."
    },
    {
      "id": "co-attested-subjects-do-not-inherit-governance-trust",
      "kind": "rule",
      "sourceDecision": "ADR-0004",
      "statement": "Subjects other than the exact GovernanceRun remain outside the governance evidence claim even when they share its signed provenance statement."
    },
    {
      "id": "companion-adapter-evidence-does-not-claim-release-or-hardware",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "Build, host, and CI evidence cannot be represented as npm publication, Bitfocus registry admission, release, physical hardware behavior, OBS truth, or operator perception."
    },
    {
      "id": "companion-api2-boundary-is-exact",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "The accepted adapter claim is limited to Node 22 ESM, Companion Module API 2.0, official @companion-module/host 1.0.1, and the tested Linux CI environment."
    },
    {
      "id": "companion-configuration-fails-closed",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "Missing or invalid endpoint, bearer, trust, URL authority, or transport security prevents admission without silently weakening the boundary."
    },
    {
      "id": "companion-feedback-is-not-optimistic",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "Actions do not change projected feedback; feedback transitions require accepted server evidence or an observed transport fact."
    },
    {
      "id": "companion-operational-authority-is-ephemeral",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "The adapter does not persist Show bindings, catalogs, revisions, snapshots, retries, command outcomes, or credentials as operational authority across restart."
    },
    {
      "id": "companion-package-retains-legal-provenance",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "Every distributable module archive retains Apache-2.0, Rodrigo Vicente attribution, and applicable adapted Bitfocus MIT notice."
    },
    {
      "id": "companion-protocol-consumption-is-public-and-pinned",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "The adapter consumes an exact digest-pinned public @overlaykit/protocol artifact and has no workspace, server-source, copied-validator, or repository-source dependency."
    },
    {
      "id": "companion-readiness-requires-server-evidence",
      "kind": "rule",
      "sourceDecision": "ADR-0003",
      "statement": "The adapter remains not ready until it has accepted complete signed bootstrap, acknowledged that exact bootstrap, and received device.ready from the server."
    },
    {
      "id": "current-change-bytes-remain-manifest-bound",
      "kind": "rule",
      "sourceDecision": "ADR-0002",
      "statement": "Every current change contract remains bound to its exact bytes by the current deterministic manifest."
    },
    {
      "id": "evidence-cannot-redefine-law",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "Evidence may answer an approved question only within the law and claim boundary that existed before the experiment."
    },
    {
      "id": "governed-attestation-subject-ambiguity-fails-closed",
      "kind": "rule",
      "sourceDecision": "ADR-0004",
      "statement": "An absent, duplicate, or digest-mismatched GovernanceRun subject is invalid evidence."
    },
    {
      "id": "governed-attestation-subject-is-name-and-digest-bound",
      "kind": "rule",
      "sourceDecision": "ADR-0004",
      "statement": "GovernanceRun provenance is admitted only from exactly one subject named governance-run.json whose SHA-256 equals the observed file bytes."
    },
    {
      "id": "law-is-compiled",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "Normative governance is the compiled plan derived from immutable accepted decisions, accepted specifications, registered mechanisms, and the active profile."
    },
    {
      "id": "legal-provenance-precedes-product-code",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "Apache-2.0 licensing, Rodrigo Vicente attribution, and applicable upstream notices must exist before adapter product code enters history."
    },
    {
      "id": "pre-implementation-field-rules-remain-unknown",
      "kind": "rule",
      "sourceDecision": "ADR-0002",
      "statement": "H-032 does not authorize claims about which individual fields of a proposed or approved contract may change."
    },
    {
      "id": "server-is-operational-authority",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "Only accepted, signed OverlayKit server evidence may establish Show bindings, catalogs, revisions, command outcomes, and production state."
    },
    {
      "id": "transition-requires-evidence",
      "kind": "rule",
      "sourceDecision": "ADR-0001",
      "statement": "No projected state transition exists without accepted evidence that justifies it."
    },
    {
      "id": "unproven-base-change-status-fails-closed",
      "kind": "rule",
      "sourceDecision": "ADR-0002",
      "statement": "Missing, invalid, identity-mismatched, hash-mismatched, or status-unproven base change evidence is an immutability violation."
    }
  ],
